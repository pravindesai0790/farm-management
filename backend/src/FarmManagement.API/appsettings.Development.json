{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=farm_management;Username=farm_user;Password=change_this_password"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:8081",
      "http://localhost:19006"
    ]
  },
  "Jwt": {
    "Issuer": "FarmManagement",
    "Audience": "FarmManagement.Web",
    "Secret": "development-only-secret-change-this-value-1234567890",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Authentication": {
    "RefreshTokenCookie": {
      "Name": "farm_refresh_token",
      "HttpOnly": true,
      "Secure": false,
      "SameSite": "Lax",
      "Path": "/api/auth"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    }
  }
}
